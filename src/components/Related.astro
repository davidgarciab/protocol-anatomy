---
export interface RelatedLink {
  href: string;
  title: string;
  kind: string;
}

interface Props {
  links: RelatedLink[];
}

const { links } = Astro.props;
---

{
  links.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">Related</h2>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.title}</a>
            <span class="kind"> {link.kind}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}
