---
import { sourceKindLabel, type Source } from '../lib/site';

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

<section class="references" aria-labelledby="references-heading">
  <h2 id="references-heading">Sources</h2>
  <ol>
    {
      sources.map((source) => (
        <li>
          <a href={source.url}>{source.title}</a>
          <div class="kind">
            {sourceKindLabel(source.kind)} · {source.publisher}
          </div>
        </li>
      ))
    }
  </ol>
</section>
