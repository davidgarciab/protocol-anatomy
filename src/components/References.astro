---
import { SOURCE_KINDS, sourceKindLabel, type Source } from '../lib/site';

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
/** Check-it-yourself order: contract code first, then the docs and papers that describe it, then governance. */
const KIND_ORDER = ['code', 'specification', 'docs', 'whitepaper', 'governance', 'security', 'research'] as const satisfies readonly (typeof SOURCE_KINDS)[number][];
const groups = KIND_ORDER.map((kind) => ({ kind, items: sources.filter((source) => source.kind === kind) })).filter(
  (group) => group.items.length > 0,
);
---

<section class="references" aria-labelledby="references-heading">
  <h2 id="references-heading">Sources</h2>
  <p class="muted">
    Check the claims yourself: each group below is a different kind of evidence. Code and specifications show what the contracts do. Documentation shows what the protocol says they do.
  </p>
  {
    groups.map((group) => (
      <>
        <h3 class="source-kind">{sourceKindLabel(group.kind)}</h3>
        <ul>
          {group.items.map((source) => (
            <li>
              <a href={source.url}>{source.title}</a>
              <div class="kind">{source.publisher}</div>
            </li>
          ))}
        </ul>
      </>
    ))
  }
</section>
