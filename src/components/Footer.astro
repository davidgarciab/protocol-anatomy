---
import { SITE } from '../lib/site';

const analytics = Boolean(import.meta.env.PUBLIC_POSTHOG_KEY);
---

<footer class="site-footer">
  <p>
    <strong>{SITE.name}.</strong> {SITE.tagline}
  </p>
  <nav class="footer-nav" aria-label="Footer">
    <a href="/protocols/">Protocols</a>
    <a href="/guides/">Version guides</a>
    <a href="/concepts/">Concepts</a>
    <a href="/glossary/">Glossary</a>
    <a href="/methodology/">Methodology</a>
    <a href="/sources/">Sources</a>
    <a href="/search/">Search</a>
    <a href="/privacy/">Privacy</a>
    {analytics && <button type="button" class="link-button" data-consent-open hidden>Cookie settings</button>}
  </nav>
  <p>
    Educational notes on published protocol designs. This is not an audit, a recommendation to allocate capital, or financial advice. The protocols named here are independent projects.
  </p>
  <p>
    Built by <a href={SITE.authorUrl}>{SITE.author}</a>. Open source on
    <a href={SITE.repoUrl}>GitHub</a>. Found a mistake or want to add a protocol?
    <a href={`${SITE.repoUrl}/blob/main/CONTRIBUTING.md`}>Contributions are welcome</a>.
  </p>
</footer>
