---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import References from '../components/References.astro';
import Related, { type RelatedLink } from '../components/Related.astro';
import { SITE, authorJsonLd, canonicalUrl, type Source } from '../lib/site';

interface Crumb {
  href?: string;
  label: string;
}

type AnyEntry =
  | CollectionEntry<'protocols'>
  | CollectionEntry<'guides'>
  | CollectionEntry<'concepts'>
  | CollectionEntry<'site'>;

interface Props {
  entry: AnyEntry;
  headings: MarkdownHeading[];
  crumbs: Crumb[];
  kicker: string;
  related: RelatedLink[];
  readingMinutes: number;
}

const { entry, headings, crumbs, kicker, related, readingMinutes } = Astro.props;
const data = entry.data;
const pathname = Astro.url.pathname;
const sources = data.sources as Source[];
const versionContext = 'versionContext' in data ? data.versionContext : undefined;
const pageUrl = canonicalUrl(pathname);
const sourceFile = entry.filePath;
const issueUrl = `${SITE.repoUrl}/issues/new?template=correction.yml&title=${encodeURIComponent(`Correction: ${data.title}`)}`;
const breadcrumb = [
  { name: 'Home', item: canonicalUrl('/') },
  ...crumbs.map((crumb, index) => ({
    name: crumb.label,
    item: crumb.href
      ? canonicalUrl(crumb.href)
      : index === crumbs.length - 1
        ? pageUrl
        : undefined,
  })),
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: data.title,
      description: data.description,
      datePublished: data.published,
      dateModified: data.lastVerified,
      url: pageUrl,
      mainEntityOfPage: pageUrl,
      author: authorJsonLd(),
      publisher: {
        '@type': 'Organization',
        name: SITE.name,
        url: SITE.url,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        ...(crumb.item ? { item: crumb.item } : {}),
      })),
    },
  ],
};
---

<BaseLayout title={data.title} description={data.description} type="article" jsonLd={jsonLd}>
  <Header slot="header" />
  <main id="main" class="page">
    <article>
      <header class="article-header">
        <Breadcrumbs items={crumbs} />
        <p class="kicker">{kicker}</p>
        <h1>{data.title}</h1>
        <p class="lede">{data.summary}</p>
        <dl class="meta-list">
          <div>
            <dt>Written by</dt>
            <dd><a href="/about/" rel="author">{SITE.author}</a></dd>
          </div>
          <div>
            <dt>Published</dt>
            <dd><time datetime={data.published}>{data.published}</time></dd>
          </div>
          <div>
            <dt>Last verified</dt>
            <dd>
              <time datetime={data.lastVerified}>{data.lastVerified}</time>{' '}
              <a href="/methodology/#what-last-verified-means">What this date means</a>
            </dd>
          </div>
          <div>
            <dt>Reading time</dt>
            <dd>About {readingMinutes} min</dd>
          </div>
          {
            versionContext && (
              <div>
                <dt>Version context</dt>
                <dd>{versionContext}</dd>
              </div>
            )
          }
        </dl>
      </header>
      <div class="article-grid">
        <div class="prose">
          <slot />
          <References sources={sources} />
          <Related links={related} />
          <p class="improve">
            See something wrong or missing?
            {sourceFile && <><a href={`${SITE.repoUrl}/edit/main/${sourceFile}`}>Suggest an edit on GitHub</a> or </>}
            <a href={issueUrl}>report a correction</a>. See <a href={`${SITE.repoUrl}/blob/main/CONTRIBUTING.md`}>how to contribute</a>.
          </p>
        </div>
        <TableOfContents headings={headings} />
      </div>
    </article>
  </main>
  <Footer slot="footer" />
</BaseLayout>
