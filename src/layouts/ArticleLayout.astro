---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import References from '../components/References.astro';
import Related, { type RelatedLink } from '../components/Related.astro';
import { getCollection } from 'astro:content';
import PathNav from '../components/PathNav.astro';
import { glossary } from '../data/glossary';
import { CONTENT_LICENSE_URL, SITE, authorJsonLd, canonicalUrl, organizationJsonLd, type Source } from '../lib/site';
import { lastModified } from '../lib/changes';
import { faqAnchor } from '../lib/anchors';
import InlineCode from '../components/InlineCode.astro';
import Calculators from '../components/Calculators.astro';

interface Crumb {
  href?: string;
  label: string;
}

type AnyEntry =
  | CollectionEntry<'protocols'>
  | CollectionEntry<'guides'>
  | CollectionEntry<'concepts'>
  | CollectionEntry<'comparisons'>
  | CollectionEntry<'site'>;

interface Props {
  entry: AnyEntry;
  headings: MarkdownHeading[];
  crumbs: Crumb[];
  kicker: string;
  related: RelatedLink[];
  readingMinutes: number;
}

const { entry, headings, crumbs, kicker, related, readingMinutes } = Astro.props;
const data = entry.data;
const pathname = Astro.url.pathname;
const sources = data.sources as Source[];
const versionContext = 'versionContext' in data ? data.versionContext : undefined;
const pageUrl = canonicalUrl(pathname);
const modified = lastModified(data);
const changes = [...data.changes].sort((a, b) => b.date.localeCompare(a.date));
const ogImage = `/og/${pathname.replace(/^\/+|\/+$/g, '')}.png`;
const sourceFile = entry.filePath;
const issueUrl = `${SITE.repoUrl}/issues/new?template=correction.yml&title=${encodeURIComponent(`Correction: ${data.title}`)}`;
const pathKey = pathname.replace(/^\/+|\/+$/g, '');
const protocolTitles = new Map((await getCollection('protocols')).map((item) => [item.id, item.data.title]));
const aboutNames: string[] =
  entry.collection === 'protocols'
    ? [data.title]
    : entry.collection === 'guides'
      ? [protocolTitles.get(entry.data.protocol) ?? entry.data.protocol]
      : entry.collection === 'concepts'
        ? entry.data.protocols.map((id) => protocolTitles.get(id) ?? id)
        : entry.collection === 'comparisons'
          ? entry.data.protocols.map((id) => protocolTitles.get(id) ?? id)
          : [];
const mentions = glossary
  .filter((term) => 'glossary' in data && data.glossary.includes(term.id))
  .map((term) => ({ '@type': 'DefinedTerm', name: term.term, url: canonicalUrl(`/glossary/${term.id}`) }));
const parentGuide =
  entry.collection === 'guides'
    ? { '@type': 'WebPage', url: canonicalUrl(`/protocols/${entry.data.protocol}`) }
    : undefined;
const wordCount = (entry.body ?? '').replace(/```[\s\S]*?```/g, ' ').split(/\s+/).filter(Boolean).length;
const faq = data.faq;
const breadcrumb = [
  { name: 'Home', item: canonicalUrl('/') },
  ...crumbs.map((crumb, index) => ({
    name: crumb.label,
    item: crumb.href
      ? canonicalUrl(crumb.href)
      : index === crumbs.length - 1
        ? pageUrl
        : undefined,
  })),
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: data.title,
      description: data.description,
      datePublished: data.published,
      dateModified: modified,
      url: pageUrl,
      image: new URL(ogImage, SITE.url).href,
      mainEntityOfPage: pageUrl,
      author: authorJsonLd(),
      publisher: organizationJsonLd(),
      isPartOf: [{ '@type': 'WebSite', '@id': `${SITE.url}/#website` }, ...(parentGuide ? [parentGuide] : [])],
      inLanguage: 'en',
      isAccessibleForFree: true,
      license: CONTENT_LICENSE_URL,
      keywords: data.tags.join(', '),
      articleSection: kicker,
      wordCount,
      ...(aboutNames.length > 0 ? { about: aboutNames.map((name) => ({ '@type': 'Thing', name })) } : {}),
      ...(mentions.length > 0 ? { mentions } : {}),
      citation: sources.map((source) => ({
        '@type': 'CreativeWork',
        name: source.title,
        url: source.url,
        publisher: { '@type': 'Organization', name: source.publisher },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        ...(crumb.item ? { item: crumb.item } : {}),
      })),
    },
    ...(faq.length > 0
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: faq.map((item) => ({
              '@type': 'Question',
              name: item.question,
              acceptedAnswer: { '@type': 'Answer', text: item.answer.replaceAll('`', '') },
            })),
          },
        ]
      : []),
  ],
};
---

<BaseLayout title={data.seoTitle ?? data.title} description={data.description} type="article" jsonLd={jsonLd} ogImage={ogImage}>
  <Header slot="header" />
  <main id="main" class="page">
    <article>
      <header class="article-header">
        <Breadcrumbs items={crumbs} />
        <p class="kicker">{kicker}</p>
        <h1>{data.title}</h1>
        <p class="lede">
          {entry.collection !== 'site' && <span class="lede-label">Short answer</span>}
          {data.summary}
        </p>
        <dl class="meta-list">
          <div>
            <dt>Written by</dt>
            <dd><a href="/about/" rel="author">{SITE.author}</a></dd>
          </div>
          <div>
            <dt>Published</dt>
            <dd><time datetime={data.published}>{data.published}</time></dd>
          </div>
          {
            modified !== data.published && (
              <div>
                <dt>Updated</dt>
                <dd>
                  <time datetime={modified}>{modified}</time> <a href="#changes">What changed</a>
                </dd>
              </div>
            )
          }
          <div>
            <dt>Last verified</dt>
            <dd>
              <time datetime={data.lastVerified}>{data.lastVerified}</time>{' '}
              <a href="/methodology/#what-last-verified-means">What this date means</a>
            </dd>
          </div>
          <div>
            <dt>Reading time</dt>
            <dd>About {readingMinutes} min</dd>
          </div>
          {
            versionContext && (
              <div>
                <dt>Version context</dt>
                <dd>{versionContext}</dd>
              </div>
            )
          }
        </dl>
      </header>
      <div class="article-grid">
        <div class="prose">
          <slot />
          {
            faq.length > 0 && (
              <section class="faq" aria-labelledby="common-questions">
                <h2 id="common-questions">Common questions</h2>
                {faq.map((item) => (
                  <div class="faq-item" id={faqAnchor(item.question)}>
                    <h3>{item.question}</h3>
                    <p>
                      <InlineCode text={item.answer} />
                    </p>
                  </div>
                ))}
              </section>
            )
          }
          <References sources={sources} />
          {
            changes.length > 0 && (
              <section class="changes" aria-labelledby="changes">
                <h2 id="changes">Changes</h2>
                <ul>
                  {changes.map((change) => (
                    <li>
                      <time datetime={change.date}>{change.date}</time>: <InlineCode text={change.summary} />
                    </li>
                  ))}
                </ul>
                <p>
                  Every change to the publication is listed on <a href="/changes/">What changed</a>.
                </p>
              </section>
            )
          }
          <Related links={related} />
          <PathNav current={pathKey} />
          <aside class="author-box" aria-labelledby="author-box-heading">
            <h2 id="author-box-heading">About the author</h2>
            <p>
              <a href="/about/" rel="author">{SITE.authorFullName}</a>. {SITE.authorBio}
              Sources last read on <time datetime={data.lastVerified}>{data.lastVerified}</time>; see the <a href="/methodology/">methodology</a>.
            </p>
          </aside>
          <p class="improve">
            See something wrong or missing?
            {sourceFile && <><a href={`${SITE.repoUrl}/blob/main/CONTRIBUTING.md#propose-a-change-fork-and-pull-request`} class="gh-link"><GitHubIcon />Propose a change via pull request</a> (<code>{sourceFile}</code>) or </>}
            <a href={issueUrl} class="gh-link"><GitHubIcon />report a correction</a>. See <a href={`${SITE.repoUrl}/blob/main/CONTRIBUTING.md`}>how to contribute</a>.
          </p>
        </div>
        <TableOfContents headings={headings} />
      </div>
    </article>
  </main>
  <Footer slot="footer" />
  <Calculators />
</BaseLayout>
