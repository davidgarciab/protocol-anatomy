---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { readingMinutes } from '../../lib/reading';
import { conceptLinks, groupLabel } from '../../lib/relate';

export async function getStaticPaths() {
  const protocols = await getCollection('protocols');
  const guides = await getCollection('guides');
  const concepts = await getCollection('concepts');
  const library = { protocols, guides, concepts };
  return concepts.map((entry) => ({
    params: { id: entry.id },
    props: { entry, library },
  }));
}

const { entry, library } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout
  entry={entry}
  headings={headings}
  kicker={groupLabel[entry.data.group]}
  readingMinutes={readingMinutes(entry.body)}
  crumbs={[{ href: '/concepts/', label: 'Concepts' }, { label: entry.data.title }]}
  related={conceptLinks(entry, library)}
>
  <Content />
</ArticleLayout>
