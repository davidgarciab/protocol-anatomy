---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, pagePath } from '../lib/site';
import { groupLabel } from '../lib/relate';
import { featuredQuestions } from '../lib/questions';

const protocols = (await getCollection('protocols')).sort((a, b) => a.data.order - b.data.order);
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const comparisons = (await getCollection('comparisons')).sort((a, b) => a.data.order - b.data.order);
const concepts = (await getCollection('concepts')).sort((a, b) => a.data.order - b.data.order);
const questions = await featuredQuestions();
const featuredConcepts = concepts.slice(0, 6);

const homeTitle = `${SITE.name}: how Aave, Uniswap, Maker, Curve and Lido work`;
const homeDescription =
  'An independent educational resource on how Aave, Uniswap, MakerDAO/Sky, Curve and Lido hold assets, price trades, liquidate collateral and change across versions, sourced to public docs and code.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: homeDescription,
};
---

<BaseLayout title={homeTitle} description={homeDescription} jsonLd={jsonLd}>
  <Header slot="header" />
  <main id="main" class="page">
    <section class="hero">
      <p class="eyebrow">Independent DeFi protocol research</p>
      <h1>{SITE.name}</h1>
      <p class="tagline">{SITE.tagline}</p>
      <p class="hero-lede">{SITE.description}</p>
      <div class="hero-actions">
        <a class="button" href="/start/">Start here</a>
        <a href="/protocols/">Browse the protocols</a>
        <a href="/methodology/">How the research is checked</a>
      </div>
    </section>

    <section class="section" aria-labelledby="questions-heading">
      <h2 id="questions-heading">Questions this site answers</h2>
      <ul class="contents-index question-index">
        {
          questions.map((item) => (
            <li>
              <a href={item.href}>
                <span class="num">?</span>
                <span>{item.question}</span>
                <span class="cat">{item.page}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p><a href="/questions/">All questions</a></p>
    </section>

    <section class="section" aria-labelledby="learn-heading">
      <h2 id="learn-heading">What a guide is for</h2>
      <div class="learn-grid">
        <article>
          <h3>The mechanism</h3>
          <p>What state the contracts store, which inputs change it, and which invariant the transaction is required to leave behind.</p>
        </article>
        <article>
          <h3>The money</h3>
          <p>Where collateral, reserves, fees, and shares sit after a supply, swap, mint, or withdrawal, including the residual loss when a rule fails.</p>
        </article>
        <article>
          <h3>The version</h3>
          <p>Which design is deployed, which design it replaced, and which behavior belongs to an older contract that integrations still call.</p>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="protocols-heading">
      <h2 id="protocols-heading">Ten protocols</h2>
      <p class="section-intro">
        Pooled and isolated lending, two kinds of automated market maker, a collateralized and a synthetic dollar, liquid staking and restaking, a capital allocator, and a yield market. They are not ten copies of one architecture.
      </p>
      <ol class="contents-index">
        {
          protocols.map((protocol, index) => (
            <li>
              <a href={pagePath(`/protocols/${protocol.id}`)}>
                <span class="num">{String(index + 1).padStart(2, '0')}</span>
                <span>{protocol.data.title}</span>
                <span class="cat">{protocol.data.category}</span>
              </a>
              <p>{protocol.data.mechanism}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section" aria-labelledby="versions-heading">
      <h2 id="versions-heading">Version and architecture</h2>
      <p class="section-intro">
        Each comparison is limited to versions that the cited documentation or repositories actually describe.
      </p>
      <ul class="contents-index">
        {
          guides.map((guide) => (
            <li>
              <a href={pagePath(`/guides/${guide.id}`)}>
                <span class="num">→</span>
                <span>{guide.data.title}</span>
                <span class="cat">{guide.data.protocol}</span>
              </a>
              <p>{guide.data.summary}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="compare-heading">
      <h2 id="compare-heading">Compare protocols</h2>
      <p class="section-intro">The same question asked of different designs.</p>
      <ul class="contents-index">
        {
          comparisons.map((entry) => (
            <li>
              <a href={pagePath(`/compare/${entry.id}`)}>
                <span class="num">⇄</span>
                <span>{entry.data.title}</span>
              </a>
              <p>{entry.data.description}</p>
            </li>
          ))
        }
      </ul>
      <p><a href="/compare/">All comparisons</a></p>
    </section>

    <section class="section" aria-labelledby="concepts-heading">
      <h2 id="concepts-heading">Concepts</h2>
      <div class="card-grid">
        {
          featuredConcepts.map((concept) => (
            <article class="plain-card">
              <p class="kicker">{groupLabel[concept.data.group]}</p>
              <h3><a href={pagePath(`/concepts/${concept.id}`)}>{concept.data.title}</a></h3>
              <p>{concept.data.description}</p>
            </article>
          ))
        }
      </div>
      <p><a href="/concepts/">All concepts</a> · <a href="/glossary/">Glossary</a></p>
    </section>
  </main>
  <Footer slot="footer" />
</BaseLayout>
